{
  "schema_version": 1,
  "project": {
    "id": "concept-discovery",
    "stage": "personal-knowledge-service",
    "product_status": "single-container-production"
  },
  "runtime": {
    "node_major": 24
  },
  "commands": {
    "doctor": "doctor",
    "validate": "validate",
    "test": "test",
    "check": "check",
    "start": "start",
    "raw": "raw"
  },
  "context": {
    "agent_entry": "AGENTS.md",
    "environment": "AI_ENVIRONMENT.md",
    "product_contract": "specs/product-contract.md",
    "workflow": "workflow/README.md",
    "active_state": "workflow-state.json"
  },
  "services": [
    {
      "name": "knowledge-app",
      "command": "npm start",
      "bind": "127.0.0.1:6806",
      "database": ".local/knowledge/workspace"
    }
  ],
  "capabilities": {
    "web_read_only": true,
    "card_sharing": true,
    "wechat_share_preview": {
      "configuration": "docs/agent-environment/commands.md",
      "requires_wechat_account": true
    },
    "raw_wiki": {
      "overview": "raw/README.md",
      "command": "npm run raw --",
      "target": "local-siyuan"
    },
    "loopback_content_shadow": {
      "command": "npm run start:shadow",
      "documentation": "docs/agent-environment/commands.md"
    },
    "offline_content_snapshot": {
      "command": "npm run build:content",
      "target": "private-read-only-sqlite",
      "documentation": "docs/agent-environment/commands.md"
    },
    "project_skills": [
      "skills/concept-discovery/SKILL.md"
    ],
    "connectors": [],
    "single_container_production": {
      "compose": "deploy/compose.content.yaml",
      "documentation": "docs/agent-environment/content-release.md",
      "verification": "test:content-container",
      "owner_packaging_command": "npm run content:package",
      "offline_deployment_verification": "test:content-offline",
      "production_bind": "127.0.0.1:16806"
    }
  }
}
